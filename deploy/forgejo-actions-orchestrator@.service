[Unit]
Description=Forgejo CI orchestrator (%i)
Documentation=https://git.hloth.dev/hloth/forgejo-actions-orchestrator
After=network-online.target nss-lookup.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=/usr/local/bin/forgejo-actions-orchestrator --config /etc/forgejo-actions-orchestrator/%i.toml

# install -d -o root -g root -m 700 /etc/forgejo-actions-orchestrator/credentials/%i
# Provider tokens go in a per-instance drop-in at forgejo-actions-orchestrator@%i.service.d/ — see deploy/providers.example.conf.
LoadCredential=forgejo-runner-token:/etc/forgejo-actions-orchestrator/credentials/%i/forgejo-runner-token
LoadCredential=forgejo-status-token:/etc/forgejo-actions-orchestrator/credentials/%i/forgejo-status-token
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s

DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
# A core dump would archive every loaded credential
LimitCORE=0

ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# AF_NETLINK because a glibc build resolves over NETLINK_ROUTE; a musl build never uses it
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @obsolete @mount @debug @cpu-emulation @module @raw-io @reboot @swap @clock
# Only outbound calls
SocketBindDeny=any
# No IPAddressAllow: an allow entry is matched first and would nullify this deny
# Needs cgroup v2 + eBPF
IPAddressDeny=169.254.169.254/32 fd00:ec2::254/128

StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=10000

[Install]
WantedBy=multi-user.target
